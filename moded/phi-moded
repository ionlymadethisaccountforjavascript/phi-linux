#!/usr/bin/env python3
"""Launcher for phi-moded.

Works from a checkout and from an installed tree, so the same file is used in
both places:

    /usr/lib/phi/moded/phi_moded/...   package
    /usr/bin/phi-moded -> ../lib/phi/moded/phi-moded
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from phi_moded.main import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
